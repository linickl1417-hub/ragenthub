# Normalize line endings across platforms.
# Linux containers exec shell scripts directly, so .sh must stay LF even when
# the repository is checked out on Windows.
* text=auto eol=lf

*.sh          text eol=lf
Dockerfile    text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.py          text eol=lf
*.java        text eol=lf
*.md          text eol=lf
*.json        text eol=lf
*.xml         text eol=lf

*.ps1         text eol=crlf
*.bat         text eol=crlf
*.cmd         text eol=crlf

*.onnx        binary
*.png         binary
*.jpg         binary
*.jar         binary
