# Copy to .env and adjust as needed; .env is in .gitignore

# LLM: mock | openai
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Business DB: sqlite | mysql | postgres
DB_BACKEND=sqlite
# DB_BACKEND=postgres
# DATABASE_URL=postgresql+psycopg://ragenthub:ragenthub@localhost:5432/ragenthub

# Vector store: chroma | pgvector
VECTOR_BACKEND=chroma
# VECTOR_BACKEND=pgvector

# Cache: memory | redis
CACHE_BACKEND=memory
# CACHE_BACKEND=redis
# REDIS_URL=redis://localhost:6379/0

# Event bus: sync | kafka
EVENT_BUS=sync
# EVENT_BUS=kafka
# KAFKA_BOOTSTRAP=localhost:9092

ENV=dev