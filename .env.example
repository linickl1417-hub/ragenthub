# RAGentHub — environment reference
# Copy to `.env` next to docker-compose.yml and edit. Only the values you
# actually need have to be set; every key below has a working default.

# ---------- Business database ----------
DB_BACKEND=postgres              # sqlite | mysql | postgres
DATABASE_URL=postgresql+psycopg://ragenthub:ragenthub@postgres:5432/ragenthub

# ---------- Vector store ----------
VECTOR_BACKEND=chroma            # chroma | pgvector
# Where Chroma persists (mounted as the ai_data volume in Docker)
RAGENTHUB_DATA_DIR=/data

# ---------- Cache / event bus ----------
CACHE_BACKEND=redis              # memory | redis
REDIS_URL=redis://redis:6379/0
EVENT_BUS=sync                   # sync | kafka
KAFKA_BOOTSTRAP=kafka:9092

# ---------- LLM ----------
LLM_PROVIDER=mock                # mock | openai (any OpenAI-compatible endpoint)
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_MODEL=gemma4:latest

# ---------- Access control ----------
# Empty = development mode (no authentication). ALWAYS set this in production.
API_KEY=
# Requests per minute per API key / client IP. 0 disables the limiter.
RATE_LIMIT_PER_MINUTE=120

# ---------- Conversation ----------
# How many previous turns are fed back into the prompt (0 disables context)
CHAT_CONTEXT_TURNS=3
# Per-message character cap when building the prompt
CHAT_CONTEXT_MAX_CHARS=500

# ---------- Misc ----------
ENV=dev
HF_ENDPOINT=https://hf-mirror.com
